{
  "version": 1,
  "headers": {
    "kind": "X-ArmorIQ-Plan-Kind",
    "parentPlanId": "X-ArmorIQ-Parent-Plan-Id",
    "promptId": "X-ArmorIQ-Prompt-Id",
    "idempotencyKey": "Idempotency-Key"
  },
  "kinds": {
    "wire": [
      "new",
      "revision",
      "refresh"
    ],
    "storedWithoutKind": "unknown"
  },
  "parserCases": [
    {
      "name": "legacy request without contract headers",
      "headers": {},
      "expect": {
        "ok": {
          "kind": "unknown",
          "parentPlanId": null,
          "promptId": null,
          "idempotencyKey": null
        }
      }
    },
    {
      "name": "legacy request with only an idempotency key",
      "headers": {
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "ok": {
          "kind": "unknown",
          "parentPlanId": null,
          "promptId": null,
          "idempotencyKey": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    },
    {
      "name": "new plan without an idempotency key",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "new",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "ok": {
          "kind": "new",
          "parentPlanId": null,
          "promptId": "33333333-3333-4333-8333-333333333333",
          "idempotencyKey": null
        }
      }
    },
    {
      "name": "revision with all contract headers",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "ok": {
          "kind": "revision",
          "parentPlanId": "11111111-1111-4111-8111-111111111111",
          "promptId": "33333333-3333-4333-8333-333333333333",
          "idempotencyKey": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    },
    {
      "name": "refresh without prompt or key",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "refresh",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111"
      },
      "expect": {
        "ok": {
          "kind": "refresh",
          "parentPlanId": "11111111-1111-4111-8111-111111111111",
          "promptId": null,
          "idempotencyKey": null
        }
      }
    },
    {
      "name": "refresh with prompt and key",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "refresh",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "ok": {
          "kind": "refresh",
          "parentPlanId": "11111111-1111-4111-8111-111111111111",
          "promptId": "33333333-3333-4333-8333-333333333333",
          "idempotencyKey": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    },
    {
      "name": "kind values are case insensitive",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "NeW",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "ok": {
          "kind": "new",
          "parentPlanId": null,
          "promptId": "33333333-3333-4333-8333-333333333333",
          "idempotencyKey": null
        }
      }
    },
    {
      "name": "header names are case insensitive",
      "headers": {
        "x-armoriq-plan-kind": "revision",
        "X-ARMORIQ-PARENT-PLAN-ID": "11111111-1111-4111-8111-111111111111",
        "x-armoriq-prompt-id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "ok": {
          "kind": "revision",
          "parentPlanId": "11111111-1111-4111-8111-111111111111",
          "promptId": "33333333-3333-4333-8333-333333333333",
          "idempotencyKey": null
        }
      }
    },
    {
      "name": "surrounding spaces are trimmed from every value",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "  REVISION  ",
        "X-ArmorIQ-Parent-Plan-Id": " 11111111-1111-4111-8111-111111111111 ",
        "X-ArmorIQ-Prompt-Id": " 33333333-3333-4333-8333-333333333333 ",
        "Idempotency-Key": " pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa "
      },
      "expect": {
        "ok": {
          "kind": "revision",
          "parentPlanId": "11111111-1111-4111-8111-111111111111",
          "promptId": "33333333-3333-4333-8333-333333333333",
          "idempotencyKey": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    },
    {
      "name": "prompt and key allow all wire punctuation",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "new",
        "X-ArmorIQ-Prompt-Id": "Prompt:v1_01.test-2",
        "Idempotency-Key": "Key:v1_01.test-2"
      },
      "expect": {
        "ok": {
          "kind": "new",
          "parentPlanId": null,
          "promptId": "Prompt:v1_01.test-2",
          "idempotencyKey": "Key:v1_01.test-2"
        }
      }
    },
    {
      "name": "prompt and key accept 128 characters",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "new",
        "X-ArmorIQ-Prompt-Id": "pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp",
        "Idempotency-Key": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
      },
      "expect": {
        "ok": {
          "kind": "new",
          "parentPlanId": null,
          "promptId": "pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp",
          "idempotencyKey": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
        }
      }
    },
    {
      "name": "repeated X-ArmorIQ-Plan-Kind",
      "headers": {
        "X-ArmorIQ-Plan-Kind": [
          "revision",
          "revision"
        ],
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "error": "duplicate_header"
      }
    },
    {
      "name": "repeated X-ArmorIQ-Parent-Plan-Id",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": [
          "11111111-1111-4111-8111-111111111111",
          "11111111-1111-4111-8111-111111111111"
        ],
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "error": "duplicate_header"
      }
    },
    {
      "name": "repeated X-ArmorIQ-Prompt-Id",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": [
          "33333333-3333-4333-8333-333333333333",
          "33333333-3333-4333-8333-333333333333"
        ],
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "error": "duplicate_header"
      }
    },
    {
      "name": "repeated Idempotency-Key",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": [
          "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ]
      },
      "expect": {
        "error": "duplicate_header"
      }
    },
    {
      "name": "empty after trimming X-ArmorIQ-Plan-Kind",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "   ",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "error": "invalid_plan_kind"
      }
    },
    {
      "name": "empty after trimming X-ArmorIQ-Parent-Plan-Id",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "   ",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "error": "invalid_parent_plan_id"
      }
    },
    {
      "name": "empty after trimming X-ArmorIQ-Prompt-Id",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "   ",
        "Idempotency-Key": "pcc1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "error": "invalid_prompt_id"
      }
    },
    {
      "name": "empty after trimming Idempotency-Key",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333",
        "Idempotency-Key": "   "
      },
      "expect": {
        "error": "invalid_idempotency_key"
      }
    },
    {
      "name": "unknown is stored only and is not a wire kind",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "unknown",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "error": "invalid_plan_kind"
      }
    },
    {
      "name": "parent without kind",
      "headers": {
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111"
      },
      "expect": {
        "error": "plan_kind_required"
      }
    },
    {
      "name": "prompt without kind",
      "headers": {
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "error": "plan_kind_required"
      }
    },
    {
      "name": "revision without parent",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "error": "parent_plan_id_required"
      }
    },
    {
      "name": "refresh without parent",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "refresh",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "error": "parent_plan_id_required"
      }
    },
    {
      "name": "new with parent",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "new",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "error": "parent_plan_id_not_allowed"
      }
    },
    {
      "name": "parent is not a UUID",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "not-a-uuid",
        "X-ArmorIQ-Prompt-Id": "33333333-3333-4333-8333-333333333333"
      },
      "expect": {
        "error": "invalid_parent_plan_id"
      }
    },
    {
      "name": "new without prompt",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "new"
      },
      "expect": {
        "error": "prompt_id_required"
      }
    },
    {
      "name": "revision without prompt",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111"
      },
      "expect": {
        "error": "prompt_id_required"
      }
    },
    {
      "name": "prompt exceeds 128 characters",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "new",
        "X-ArmorIQ-Prompt-Id": "ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"
      },
      "expect": {
        "error": "invalid_prompt_id"
      }
    },
    {
      "name": "prompt contains a forbidden character",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "new",
        "X-ArmorIQ-Prompt-Id": "prompt/1"
      },
      "expect": {
        "error": "invalid_prompt_id"
      }
    },
    {
      "name": "key exceeds 128 characters",
      "headers": {
        "Idempotency-Key": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
      },
      "expect": {
        "error": "invalid_idempotency_key"
      }
    },
    {
      "name": "key contains a forbidden character",
      "headers": {
        "Idempotency-Key": "key/1"
      },
      "expect": {
        "error": "invalid_idempotency_key"
      }
    },
    {
      "name": "kind error wins over parent prompt and key errors",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "other",
        "X-ArmorIQ-Parent-Plan-Id": "bad",
        "X-ArmorIQ-Prompt-Id": "bad/prompt",
        "Idempotency-Key": "bad/key"
      },
      "expect": {
        "error": "invalid_plan_kind"
      }
    },
    {
      "name": "parent error wins over prompt and key errors",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "bad",
        "X-ArmorIQ-Prompt-Id": "bad/prompt",
        "Idempotency-Key": "bad/key"
      },
      "expect": {
        "error": "invalid_parent_plan_id"
      }
    },
    {
      "name": "prompt error wins over key error",
      "headers": {
        "X-ArmorIQ-Plan-Kind": "revision",
        "X-ArmorIQ-Parent-Plan-Id": "11111111-1111-4111-8111-111111111111",
        "X-ArmorIQ-Prompt-Id": "bad/prompt",
        "Idempotency-Key": "bad/key"
      },
      "expect": {
        "error": "invalid_prompt_id"
      }
    }
  ],
  "canonicalJson": [
    {
      "name": "sort keys at several depths",
      "input": {
        "z": 9,
        "a": {
          "z": 2,
          "a": {
            "y": 1,
            "b": 0
          }
        },
        "m": [
          {
            "z": false,
            "a": true
          }
        ]
      },
      "expected": "{\"a\":{\"a\":{\"b\":0,\"y\":1},\"z\":2},\"m\":[{\"a\":true,\"z\":false}],\"z\":9}"
    },
    {
      "name": "arrays keep their order while object keys sort",
      "input": [
        {
          "z": 1,
          "a": 2
        },
        3,
        1,
        [
          false,
          true
        ],
        {
          "b": null,
          "a": 0
        }
      ],
      "expected": "[{\"a\":2,\"z\":1},3,1,[false,true],{\"a\":0,\"b\":null}]"
    },
    {
      "name": "nested empty objects and arrays",
      "input": {
        "z": [
          {},
          []
        ],
        "a": {
          "emptyObject": {},
          "emptyArray": []
        }
      },
      "expected": "{\"a\":{\"emptyArray\":[],\"emptyObject\":{}},\"z\":[{},[]]}"
    },
    {
      "name": "JSON string escaping",
      "input": "quote \" backslash \\ newline\n control\u0001 backspace\b tab\t formfeed\f carriage return\r",
      "expected": "\"quote \\\" backslash \\\\ newline\\n control\\u0001 backspace\\b tab\\t formfeed\\f carriage return\\r\""
    },
    {
      "name": "non ASCII letters and UTF-16 key order",
      "input": {
        "漢": "東京",
        "é": "café",
        "Ω": "Ελλάδα",
        "ä": "München",
        "Å": "Ångström",
        "a": "naïve",
        "Z": "Zürich"
      },
      "expected": "{\"Z\":\"Zürich\",\"a\":\"naïve\",\"Å\":\"Ångström\",\"ä\":\"München\",\"é\":\"café\",\"Ω\":\"Ελλάδα\",\"漢\":\"東京\"}"
    },
    {
      "name": "integer property names sort lexically",
      "input": {
        "2": "two",
        "10": "ten",
        "1": "one"
      },
      "expected": "{\"1\":\"one\",\"10\":\"ten\",\"2\":\"two\"}"
    },
    {
      "name": "positive integer",
      "input": 42,
      "expected": "42"
    },
    {
      "name": "negative integer",
      "input": -17,
      "expected": "-17"
    },
    {
      "name": "zero",
      "input": 0,
      "expected": "0"
    },
    {
      "name": "safe integer bounds",
      "input": [
        9007199254740991,
        -9007199254740991
      ],
      "expected": "[9007199254740991,-9007199254740991]"
    },
    {
      "name": "true",
      "input": true,
      "expected": "true"
    },
    {
      "name": "false",
      "input": false,
      "expected": "false"
    },
    {
      "name": "null",
      "input": null,
      "expected": "null"
    },
    {
      "name": "empty string",
      "input": "",
      "expected": "\"\""
    }
  ],
