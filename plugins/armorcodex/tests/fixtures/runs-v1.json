      "report": {
        "run_id": "prompt-1",
        "report_seq": 0,
        "session_id": "session-1",
        "started_at": "2026-11-14T12:00:00Z",
        "tool_calls": 0,
        "gated_tool_calls": 0,
        "plan_ids": []
      },
      "outcome": "rejected",
      "error": "invalid_report_seq"
    }
  ],
  "labels": {
    "endReasons": {
      "stop": "Turn ended",
      "next_prompt": "Next prompt started",
      "session_end": "Session ended",
      "recovered": "Recovered after a restart"
    },
    "noPlanReasons": {
      "monitor_mode": "Monitor mode",
      "no_tool_use": "No tool use",
      "read_only": "Read only tools",
      "backend_unreachable": "Backend unreachable",
      "request_failed": "Plan request failed",
      "plan_rejected": "Plan rejected",
      "not_registered": "No plan registered",
      "plan_missing": "Plan not stored"
    }
  }
}
