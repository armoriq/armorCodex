    },
    {
      "name": "chat only run",
      "report": {
        "run_id": "prompt-1",
        "report_seq": 2,
        "session_id": "session-1",
        "started_at": "2026-11-14T12:00:00Z",
        "tool_calls": 0,
        "gated_tool_calls": 0,
        "plan_ids": [],
        "ended_at": "2026-11-14T12:00:10Z",
        "end_reason": "stop",
        "no_plan_reason": "no_tool_use"
      },
