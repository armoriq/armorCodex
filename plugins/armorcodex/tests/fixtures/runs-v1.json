    },
    {
      "name": "completed run with a confirmed plan",
      "report": {
        "run_id": "prompt-1",
        "report_seq": 2,
        "session_id": "session-1",
        "started_at": "2026-11-14T12:00:00Z",
        "tool_calls": 2,
        "gated_tool_calls": 1,
        "plan_ids": [
          "11111111-1111-4111-8111-111111111111"
        ],
        "ended_at": "2026-11-14T12:01:00Z",
        "end_reason": "stop"
